namespace AlfaHackathonApi.Domain;

@doc("""
    Непрозрачный идентификатор компании. У компаний из данных банка совпадает с SYNTHETIC_U, например U_9250,
    у созданных пользователями назначается сервером. Клиент не разбирает формат и не выводит из него происхождение.
    """)
@minLength(1)
scalar CompanyId extends string;
