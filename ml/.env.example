# Скопировать в ml/.env и заполнить. Файл .env в репозиторий не коммитится.

# Ключ к моделям организаторов (общий для команды, дневной лимит ~500 ₽)
RADAR_ML_LLM_API_KEY=
RADAR_ML_LLM_BASE_URL=https://changellenge.up.railway.app/v1
# live — модели; off — только правила (без расхода лимита); stub — заглушки для тестов
RADAR_ML_LLM_MODE=live
# Сколько из общего лимита разрешено тратить сервису в сутки, ₽ (остальное — на разработку)
RADAR_ML_LLM_DAILY_BUDGET_RUB=350
# Доля лимита, после которой работают только интерактивные задачи (вопросы, извлечение фактов)
RADAR_ML_LLM_ECONOMY_RATIO=0.8

# Межсервисный токен: бэкенд передаёт его в заголовке X-Internal-Token. Пусто — проверка выключена.
RADAR_ML_INTERNAL_TOKEN=

# Фоновый сбор новостей из config/sources.yaml, минут; 0 — выключен
RADAR_ML_COLLECT_INTERVAL_MIN=0
# Загрузить снимок новостей при пустой базе (для воспроизводимой проверки без сети)
RADAR_ML_LOAD_SNAPSHOT_ON_START=true
# «Сейчас» для свежести событий в демо на снимке; пусто — реальное время
RADAR_ML_REFERENCE_TIME=
